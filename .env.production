# Production Environment Configuration
# Copy this file to .env.local and fill in the actual values

# Database Configuration
DATABASE_URL="postgresql://qms_user:your_secure_password@postgres:5432/qms_production"
POSTGRES_DB="qms_production"
POSTGRES_USER="qms_user"
POSTGRES_PASSWORD="your_secure_password"

# Redis Configuration
REDIS_URL="redis://:your_redis_password@redis:6379"
REDIS_PASSWORD="your_redis_password"

# Better Auth Configuration
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
BETTER_AUTH_URL="https://your-domain.com"
NEXT_PUBLIC_BETTER_AUTH_URL="https://your-domain.com"

# Application Configuration
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_VERSION="0.2.2"

# File Upload Configuration
UPLOAD_DIR="/app/uploads"
MAX_FILE_SIZE="50MB"

# Email Configuration (if using email features)
SMTP_HOST="your-smtp-host"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="noreply@your-domain.com"

# Monitoring and Logging
LOG_LEVEL="info"
ENABLE_METRICS="true"

# Security Configuration
CORS_ORIGIN="https://your-domain.com"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="15"

# Backup Configuration
BACKUP_RETENTION_DAYS="30"
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
